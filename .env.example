# Moteur de mesure — atlas/agence/acquisition/moteur-de-mesure.md

# Pose par `npx convex dev`, a recopier dans Vercel.
NEXT_PUBLIC_CONVEX_URL=

# Secret partage entre la route /api/visite et la mutation Convex.
# A generer une fois, puis a poser des deux cotes :
#   - ici et dans Vercel
#   - dans le tableau de bord Convex, Settings > Environment Variables
MOTEUR_SECRET=

# Secret du webhook Cal.com, a poser UNIQUEMENT cote Convex
# (Settings > Environment Variables), pas ici.
# CAL_WEBHOOK_SECRET=
